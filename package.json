{
  "name": "@capsule",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "build": "pnpm build:common && pnpm build:server && pnpm build:client",
    "build:server": "pnpm --filter @capsule/backend build",
    "build:client": "pnpm --filter @capsule/frontend build",
    "build:common": "pnpm --filter @capsule/common build",
    "build:landing": "pnpm --filter @capsule/landing build",
    "server:dev": "pnpm --filter @capsule/backend start:dev",
    "server": "pnpm --filter @capsule/backend start",
    "client:dev": "pnpm --filter @capsule/frontend dev",
    "client": "pnpm --filter @capsule/frontend start",
    "landing:dev": "pnpm --filter @capsule/landing dev",
    "landing": "pnpm --filter @capsule/landing start",
    "docker:build:frontend": "docker build -t capsule-frontend -f ./frontend/Dockerfile .",
    "docker:run:frontend": "docker run --rm -p 4000:4000 capsule-frontend:latest",
    "docker:build:server": "docker build --rm -t capsule-server -f ./backend/Dockerfile .",
    "docker:run:server": "docker run --rm --env-file ./backend/.env -p 5555:5555 capsule-server:latest",
    "docker:build:landing": "docker build -t capsule-landing -f ./landing/Dockerfile .",
    "docker:run:landing": "docker run --rm -p 4100:4100 capsule-landing:latest",
    "docker:run:frontend:debug": "docker run -it --rm -p 4000:4000 --entrypoint /bin/sh capsule-frontend:latest",
    "docker:run:server:debug": "docker run -it --rm -p 5555:5555 --entrypoint /bin/sh capsule-server:latest"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@9.15.0",
  "devDependencies": {
    "typescript": "^5.7.3"
  },
  "prisma": {
    "schema": "./backend/prisma/schema.prisma"
  }
}
