generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URI")
}

model User {
  id        String   @id @default(uuid())

  email     String   @unique
  password  String?
  bio    String   @default("")
  capsulesQuantity Int @default(0) @map("capsules_quantity")
  avatarUrl String? @map("avatar_url")
  fullName String @map("full_name")

  name      String @unique

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  items Clothes[] 

  @@map("users")
}

model Clothes {
  id        String   @id @default(uuid())
  imageUrl  String
  brand     String
  category  ClothesCategory
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy User @relation(fields: [createdById], references: [id])
  createdById String

  @@map("clothes")
}

enum ClothesCategory {
  SHIRT
  PANTS
  DRESS
  JACKET
  COAT
  SKIRT
  SHORTS
  JEANS
  SWIMWEAR
  ACCESSORY
  SHOES
  BAG
  OTHER
  UNDERWEAR
  SLEEPWEAR
  SWIMSUIT
}
